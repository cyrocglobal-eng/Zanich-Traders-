# Copy to .env.local. Keep credentials out of Git and chat.
NEXT_PUBLIC_SITE_URL=https://zanichtraders.co.ke
# Use preview with the temporary EC2 URL before domain and HTTPS activation.
DEPLOYMENT_STAGE=production
# Set true only for the real production deployment after release checks.
SITE_INDEXABLE=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=

# PostgreSQL with TLS verification configured according to your provider.
DATABASE_URL=
# Resend API key and a sender on your verified domain. Recipient is fixed in code.
RESEND_API_KEY=
EMAIL_FROM=
# Choose a Responses API model supporting structured outputs in your account.
OPENAI_API_KEY=
OPENAI_MODEL=

# A random secret of at least 32 characters, for the scheduled outbox endpoint.
OUTBOX_SECRET=
# A different random secret of at least 32 characters, used for hashed rate-limit keys.
RATE_LIMIT_SALT=
# Set ONLY when your trusted proxy overwrites this header:
# x-forwarded-for, x-real-ip, or cf-connecting-ip. Empty uses a conservative shared bucket.
TRUSTED_IP_HEADER=
# Business owner confirmation of the existing 50+ brands claim before launch.
BRANDS_SERVED_CONFIRMED=false
